<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base gradient background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#F6F8FB"
                android:centerColor="#EEF2F7"
                android:endColor="#E7ECF4"
                android:angle="270" />
        </shape>
    </item>

    <!-- Top-right accent blob -->
    <item android:top="-140dp" android:right="-120dp">
        <shape android:shape="oval">
            <size android:width="320dp" android:height="320dp" />
            <solid android:color="#1A16A34A" />
        </shape>
    </item>

    <!-- Top-left soft dark blob -->
    <item android:top="-180dp" android:left="-160dp">
        <shape android:shape="oval">
            <size android:width="380dp" android:height="380dp" />
            <solid android:color="#120F2E4E" />
        </shape>
    </item>

    <!-- Bottom-right glow -->
    <item android:bottom="-160dp" android:right="-140dp">
        <shape android:shape="oval">
            <size android:width="360dp" android:height="360dp" />
            <solid android:color="#1216A34A" />
        </shape>
    </item>
</layer-list>
