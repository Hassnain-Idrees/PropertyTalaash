<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid base color -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0F2E4E" />
        </shape>
    </item>

    <!-- Large top-left gradient blob -->
    <item android:top="-200dp" android:left="-200dp">
        <shape android:shape="oval">
            <size android:width="600dp" android:height="600dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="300dp"
                android:startColor="#1A16A34A"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Smaller bottom-right gradient blob -->
    <item android:bottom="-150dp" android:right="-150dp">
        <shape android:shape="oval">
            <size android:width="450dp" android:height="450dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="225dp"
                android:startColor="#26FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Subtle mesh pattern overlay or just another blob -->
    <item android:top="100dp" android:right="-100dp">
        <shape android:shape="oval">
            <size android:width="400dp" android:height="400dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="200dp"
                android:startColor="#0D16A34A"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
