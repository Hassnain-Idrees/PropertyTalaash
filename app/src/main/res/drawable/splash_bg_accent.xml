<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ps_background" />
        </shape>
    </item>

    <!-- Top-left soft blob -->
    <item android:top="-120dp" android:left="-140dp">
        <shape android:shape="oval">
            <size android:width="320dp" android:height="320dp" />
            <solid android:color="#1A0F2E4E" />
        </shape>
    </item>

    <!-- Bottom-right soft blob -->
    <item android:bottom="-160dp" android:right="-140dp">
        <shape android:shape="oval">
            <size android:width="360dp" android:height="360dp" />
            <solid android:color="#140F2E4E" />
        </shape>
    </item>

</layer-list>
